# cp .env.example .env
CHAIN_IMAGE=botchainprod/chain-node-rpc:testnet-ccfbce-20260702135343

# 验证者密钥密码（首次生成密钥时使用）
PASSWORD=localchain-dev

DB_ENGINE=pebble
MINER_GAS_PRICE=20000000000
MINER_GAS_LIMIT=35000000
STAKE_AMOUNT=2001

# start.sh 会在 validator_1 就绪后自动填写
BOOTNODES=

FULL_CACHE_MB=4096
ARCHIVE_CACHE_MB=8192

# 外部 / Tailscale：填部署机 MagicDNS 或 100.x（勿带 http://）
# 例: homeserver.tail-xxxxx.ts.net
PUBLIC_HOST=localhost
BIND_ADDR=0.0.0.0
HTTP_CORS_DOMAIN=*
HTTP_VHOSTS=*
WS_ORIGINS=*

START_BLOCKSCOUT=1
WAIT_RPC_TIMEOUT_SEC=180
