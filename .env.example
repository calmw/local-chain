# local-chain compose / start_node.sh
# Apple Silicon / arm64：用 mac 镜像。Linux amd64 宿主机改用下一行（并注释本行）
# 勿同时保留两行未注释的 CHAIN_IMAGE（后者会覆盖前者）；amd64 镜像在 arm64 Docker 上会 blst SIGILL
CHAIN_IMAGE=calmw/botchain-node-0809-mac:v1.0.0
# CHAIN_IMAGE=calmw/botchain-node-0809-linux:v1.0.0

# 验证者密钥密码（首次生成密钥时使用；请按需修改）
PASSWORD=localchain-dev

DB_ENGINE=pebble
MINER_GAS_PRICE=20000000000
MINER_GAS_LIMIT=35000000
STAKE_AMOUNT=2001

# Docker 内网固定 IP（P2P bootnode 必须用 IP）
CHAIN_SUBNET=172.28.0.0/24
CHAIN_GATEWAY=172.28.0.1
IP_VALIDATOR_1=172.28.0.11
IP_VALIDATOR_2=172.28.0.12
IP_FULL=172.28.0.13
IP_ARCHIVE=172.28.0.14

# 由 start_node.sh 在 validator_1 就绪后自动写入（公钥 + IP_VALIDATOR_1）
BOOTNODES=enode://449fd352f6a234cbd90ecf919c183c33f794ac99df3210de07c5f3f4976b445c9f4e7f436385d06b04e967af2d6ce212a694a585bd341f53955e0b8c0640d364@172.28.0.11:30303

FULL_CACHE_MB=4096
ARCHIVE_CACHE_MB=8192

# -------- 外部 / Tailscale 访问 --------
# 填家里那台机器的 Tailscale MagicDNS（推荐）或 100.x 地址，例如:
#   PUBLIC_HOST=homeserver.tail-xxxxx.ts.net
#   PUBLIC_HOST=100.64.1.2
# 本机调试可先留 localhost；外出访问务必改成 Tailscale 主机名后重新 ./start_node.sh
PUBLIC_HOST=localhost
# 端口监听地址（0.0.0.0 = 局域网/Tailscale 可访问）
BIND_ADDR=0.0.0.0
HTTP_CORS_DOMAIN=*
HTTP_VHOSTS=*
WS_ORIGINS=*

# start_node.sh 行为
START_BLOCKSCOUT=1
WAIT_RPC_TIMEOUT_SEC=180
