# local-chain — 家里 Ubuntu + Tailscale 测试用（可与本机 BSC 并存）
# 用法（在 Ubuntu 机器仓库根目录）:
#   git pull
#   cp .env.ubuntu .env
#   cp -n blockscout/.env.example blockscout/.env
#   ./images.sh pull   # 或把 mac 上 images/*.tar 拷过去后 ./images.sh load
#   ./start.sh         # 会把 PUBLIC_HOST 同步进 blockscout/.env 的 NEXT_PUBLIC_*
#
# 注意:
#   - 本机按 amd64 Ubuntu 使用 *-linux 镜像；若是 arm64 Ubuntu 请改回 *-mac
#   - 勿同时保留两行未注释的 CHAIN_IMAGE
#   - BOOTNODES 由 start.sh 在 validator_1 就绪后自动写入，可留空
#   - 宿主机端口已避开 BSC 常用 8545/30303；钱包 RPC 用 :18575
#   - 若 Blockscout :80 也被占用，在 blockscout/.env 设 PROXY_HTTP_PORT=18080 等

CHAIN_IMAGE=calmw/botchain-node-0809-linux:v1.0.0
# CHAIN_IMAGE=calmw/botchain-node-0809-mac:v1.0.0

PASSWORD=localchain-dev

DB_ENGINE=pebble
MINER_GAS_PRICE=20000000000
MINER_GAS_LIMIT=35000000
STAKE_AMOUNT=2001

CHAIN_SUBNET=172.30.88.0/24
CHAIN_GATEWAY=172.30.88.1
CHAIN_NETWORK=bot-local-chain_net
IP_VALIDATOR_1=172.30.88.11
IP_VALIDATOR_2=172.30.88.12
IP_FULL=172.30.88.13
IP_ARCHIVE=172.30.88.14

BOOTNODES=

FULL_CACHE_MB=4096
ARCHIVE_CACHE_MB=8192

# Tailscale：这台 Ubuntu 的 100.x（也可用 MagicDNS 主机名）
PUBLIC_HOST=100.75.33.104
BIND_ADDR=0.0.0.0
HTTP_CORS_DOMAIN=*
HTTP_VHOSTS=*
WS_ORIGINS=*

# 宿主机端口：与本机 BSC 默认 8545/8546/30303 错开（容器内仍是 8545/8546/30303）
HOST_PORT_V1_HTTP=18545
HOST_PORT_V1_WS=18546
HOST_PORT_V1_P2P=40303
HOST_PORT_V2_HTTP=18555
HOST_PORT_V2_WS=18556
HOST_PORT_V2_P2P=40304
HOST_PORT_FULL_HTTP=18565
HOST_PORT_FULL_WS=18566
HOST_PORT_FULL_P2P=40305
HOST_PORT_ARCHIVE_HTTP=18575
HOST_PORT_ARCHIVE_WS=18576
HOST_PORT_ARCHIVE_P2P=40306

# geth 日志：3=info 4=debug 5=detail
VERBOSITY=4

START_BLOCKSCOUT=1
WAIT_RPC_TIMEOUT_SEC=180
