# local-chain Blockscout — 固定镜像版本（勿用 latest）
# Compose 树参考 upstream docker-compose；GHCR 公开镜像版本见下方注释
#
# 说明: GHCR 对 backend/frontend 近版未公开 semver 标签，故钉 digest；
#       镜像 OCI label: backend=v9.0.2、frontend=v2.3.5（与 GitHub 最新 release 不同步）
#       微服务使用公开的 vX.Y.Z 标签。

# backend / nft_media_handler（OCI version=v9.0.2）
BLOCKSCOUT_IMAGE=ghcr.io/blockscout/blockscout@sha256:7659f168e4e2f6b73dd559ae5278fe96ba67bc2905ea01b57a814c68adf5a9dc

# frontend（OCI version=v2.3.5）
FRONTEND_IMAGE=ghcr.io/blockscout/frontend@sha256:4b69f44148414b55c6b8550bc3270c63c9f99e923d54ef0b307e762af6bac90a

STATS_DOCKER_TAG=v2.17.0
VISUALIZER_DOCKER_TAG=v0.2.1
SIG_PROVIDER_DOCKER_TAG=v1.1.1
SMART_CONTRACT_VERIFIER_DOCKER_TAG=v1.10.6
USER_OPS_INDEXER_DOCKER_TAG=v1.4.3

# 对外访问主机名（Tailscale MagicDNS / 100.x / 局域网 IP）
# 也可只在仓库根目录 .env 设置 PUBLIC_HOST，由 ../start_node.sh / start_blockscout.sh 同步到这里
PUBLIC_HOST=localhost
BIND_ADDR=0.0.0.0

CHAIN_ID=100000
NETWORK_NAME=Local Chain
NETWORK_SHORT_NAME=Local
COIN=LC
COIN_NAME=LocalCoin

# 容器内索引 RPC（走 docker 网络，勿改成 PUBLIC_HOST）
RPC_HTTP_URL=http://archive_node:8545/
RPC_TRACE_URL=http://archive_node:8545/
RPC_WS_URL=ws://archive_node:8546/

INDEXER_DISABLE_INTERNAL_TRANSACTIONS_FETCHER=false
CHECK_ORIGIN=false

# 浏览器访问用（客户端机器要能解析 PUBLIC_HOST）
NEXT_PUBLIC_API_PROTOCOL=http
NEXT_PUBLIC_APP_PROTOCOL=http
NEXT_PUBLIC_API_HOST=localhost
NEXT_PUBLIC_APP_HOST=localhost
NEXT_PUBLIC_STATS_API_HOST=http://localhost:8080
NEXT_PUBLIC_VISUALIZE_API_HOST=http://localhost:8081
NEXT_PUBLIC_NETWORK_RPC_URL=http://localhost:8575
