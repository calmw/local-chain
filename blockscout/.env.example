# local-chain Blockscout — pin relatively new prebuilt images
# Compose tree aligned with blockscout/blockscout v11.2.5

DOCKER_TAG=latest
FRONTEND_DOCKER_TAG=latest
STATS_DOCKER_TAG=latest
VISUALIZER_DOCKER_TAG=latest
SIG_PROVIDER_DOCKER_TAG=latest
SMART_CONTRACT_VERIFIER_DOCKER_TAG=latest
USER_OPS_INDEXER_DOCKER_TAG=latest

# 对外访问主机名（Tailscale MagicDNS / 100.x / 局域网 IP）
# 也可只在仓库根目录 .env 设置 PUBLIC_HOST，由 ../start.sh 自动同步到这里
PUBLIC_HOST=localhost
BIND_ADDR=0.0.0.0

CHAIN_ID=100000
NETWORK_NAME=Local Chain
NETWORK_SHORT_NAME=Local
COIN=LC
COIN_NAME=LocalCoin

# 容器内索引 RPC（走 docker 网络，勿改成 PUBLIC_HOST）
RPC_HTTP_URL=http://archive_node:8545/
RPC_TRACE_URL=http://archive_node:8545/
RPC_WS_URL=ws://archive_node:8546/

INDEXER_DISABLE_INTERNAL_TRANSACTIONS_FETCHER=false
CHECK_ORIGIN=false

# 浏览器访问用（客户端机器要能解析 PUBLIC_HOST）
NEXT_PUBLIC_API_PROTOCOL=http
NEXT_PUBLIC_APP_PROTOCOL=http
NEXT_PUBLIC_API_HOST=localhost
NEXT_PUBLIC_APP_HOST=localhost
NEXT_PUBLIC_STATS_API_HOST=http://localhost:8080
NEXT_PUBLIC_VISUALIZE_API_HOST=http://localhost:8081
NEXT_PUBLIC_NETWORK_RPC_URL=http://localhost:8575
